# ========================================================
# 1. CLion & CMake 编译构建缓存 (核心占用大户)
# ========================================================
build/
cmake-build-*/
Debug/
Release/
bin/
obj/

# ========================================================
# 2. 嵌入式编译二进制产物与生成文件
# ========================================================
*.o
*.obj
*.d
*.elf
*.hex
*.bin
*.axf
*.map
*.crf
*.lst

# ========================================================
# 3. CLion / JetBrains IDE 专属配置与缓存
# ========================================================
# 注意: 这里必须写 .idea/* 而不是 .idea/ —— git 的规则是"父目录被排除时,
# 无法再重新包含其下的文件", 写成 .idea/ 时下面的 ! 例外不会生效。
.idea/*
# 例外: 项目拼写词典值得入库 —— 它收录的是本工程的领域术语 (HRTIM/NPULSE/RXNE
# 等), 入库后重新克隆即可直接消除约 230 条拼写类告警噪音, 且不会掩盖真正的
# 拼写错误 (区别于"全局关闭拼写检查")。
!.idea/dictionaries/
!.idea/dictionaries/project.xml
.vscode/
*.launch
*.uvoptx
*.uvguix.*
*.scvd
*.dep
*.bak
*.tmp
*.log
litellm.log

# ========================================================
# 4. 操作系统临时文件
# ========================================================
.DS_Store
Thumbs.db
desktop.ini
# ========================================================
# 5. Python 上位机 / PyInstaller 打包产物
# ========================================================
__pycache__/
*.pyc
*.spec
pc_host/build/
pc_host/dist/
# 注: screenshots/ 已取消忽略 —— README.md 需要引用这些实拍图/波形图,
# 推到 GitHub 后必须能正常渲染。代价是仓库会增大 (波形图单张约 7MB)。

# ========================================================
# 6. Claude Code 本地配置 (勿提交到仓库)
# ========================================================
.claude/

# ========================================================
# 7. 代码库分析临时快照 (repomix / tree 导出)
# ========================================================
repomix-core.txt
tree.txt
